{
  "name": "cineplay-ott-engine",
  "version": "1.0.0",
  "description": "Cross-Platform OTT Streaming Engine (Mobile, Web, Smart TV, Roku)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export:web",
    "build:tizen": "npm run build:web && cd platforms/smart-tv/tizen && tizen package -t wgt -s CinePlayCert",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "expo": "~50.0.14",
    "expo-av": "~13.10.5",
    "expo-linear-gradient": "~12.7.1",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "^5.1.3"
  },
  "private": true
}
